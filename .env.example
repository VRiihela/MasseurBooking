DATABASE_URL=postgres://localhost:5432/masseur_booking
DATABASE_SSL=false
PORT=3000

# Placeholder admin credential until real masseur login (email/password or
# magic link) exists -- see src/config/auth.ts. Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASSEUR_ADMIN_TOKEN=change-me-to-a-long-random-value

# Email worker (src/services/emailWorker.ts) -- sends queued booking
# notification emails via Postmark's HTTP API.
POSTMARK_API_TOKEN=change-me-to-your-postmark-server-token
EMAIL_FROM_ADDRESS=bookings@example.com
