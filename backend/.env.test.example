# Copy this file to backend/.env.test and adjust if your local Postgres
# setup differs. backend/vitest.config.ts reads .env.test directly at
# config-load time -- it is never inherited from whatever DATABASE_URL a
# calling shell happens to have exported, and the database name here MUST
# contain "test" (see the safety guard in test/helpers/fixtures.ts).
#
# Same local Postgres container as dev (backend/.env.example), just a
# different database name -- no new infrastructure needed. One-time setup:
#   createdb masseur_booking_test
#   psql -d masseur_booking_test -f src/db/migrations/001_init_core_tables.sql
#   ...(apply every file in src/db/migrations/ in order)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/masseur_booking_test
DATABASE_SSL=false
