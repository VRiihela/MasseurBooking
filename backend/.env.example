DATABASE_URL=postgres://localhost:5432/masseur_booking
DATABASE_SSL=false
PORT=3000

# Masseur admin login (magic link, no password) -- see
# src/services/adminAuthService.ts. The admin is a v1 singleton identified by
# this email; POST /auth/login-request only enqueues a login link when the
# submitted email matches it.
ADMIN_EMAIL=admin@example.com

# Base URL used to build absolute magic-link URLs sent by email -- both the
# masseur admin login link above and the customer booking-management links
# (view/cancel/reschedule, see src/services/emailQueueService.ts) (no
# trailing slash needed).
APP_BASE_URL=https://example.com

# Email worker (src/services/emailWorker.ts) -- sends queued booking
# notification emails via Postmark's HTTP API.
POSTMARK_API_TOKEN=change-me-to-your-postmark-server-token
EMAIL_FROM_ADDRESS=bookings@example.com

# The single browser origin allowed to call this API cross-origin (see
# src/config/cors.ts) -- the web/ frontend's origin. Never a wildcard: this
# same app also serves the authenticated admin routes.
CORS_ORIGIN=http://localhost:5173
